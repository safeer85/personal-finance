# Local PostgreSQL (use your own password in your ignored .env files).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pocket?schema=public"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pocket?schema=public"
# For Neon, replace these with pooled and direct URLs, both with sslmode=require.
# Run npm run auth:setup to set these securely in .env.local.
OWNER_USERNAME="owner"
OWNER_PASSWORD_HASH=""
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
