generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Record {
  id String @id @default(cuid())
  kind String
  name String
  category String
  amount Int
  date String
  minimum Int @default(0)
  target Int @default(0)
  createdAt DateTime @default(now())
}
model LoginAttempt {
  id String @id
  attempts Int @default(1)
  expiresAt DateTime
}
