{
  "name": "finance-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "prisma generate && prisma db push",
    "typecheck": "tsc --noEmit",
    "test:hosting": "node --test scripts/test-hosting-config.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "vercel-build": "node scripts/check-hosting-env.mjs && prisma generate && prisma migrate deploy && next build",
    "auth:setup": "node scripts/setup-owner.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "radix-ui": "^1.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "6.19.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0"
  }
}
